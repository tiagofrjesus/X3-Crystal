#<AdxTL>
###########################################################################################################
# ZTRTJOULEG - processo de inicializacao (AREPORT.TRTINI) do relatorio TEB_PIECE.
#
# Desde 2026-10-07 o TEB_PIECE.rpt NAO depende da AREPORTM (liga GACCENTRY->GJOURNAL diretamente), por
# isso este script ja nao precisa de chamar "Gosub TRTJOU From RPTLEG". Serve para:
#  - as acoes do ecra de parametros (CONT1/INIPAR2), iguais ao TRTJOULEG standard;
#  - completar os parametros que nao chegam quando se imprime pelo BOTAO Imprimir do GESGAS
#    (GESARX: codigo interno PIECE -> listas PIECE e TEB_PIECE): "numedt" e "typpcedeb/fin";
#    sem isto o Crystal da ERR 504 "Valores de parametro ausentes" (validado 2026-10-07);
#  - dar ao ficheiro gerado o NUMERO DO DOCUMENTO como nome (so destinos ficheiro/email; ver nota).
#
# Sequencia observada no X3 (diagnostico 2026-10-07): OUVRE, CONTPRT, CONT1/CONT2, CONTSAI, FINAIMP1,
# EXEC, Subprog IMPRIME(NBPAR,PARAMETRE), AP_IMPRIME, FIN. No IMPRIME chegam os 50 parametros que vao
# para o servidor de impressao: __DESTINATION=3 (ficheiro, tambem na pre-visualizacao web),
# _FormatExport=~29 (PDF), pcedeb/pcefin = numero da peca. Os valores dos parametros "_..." levam chr$(1).
###########################################################################################################

$ACTION
Case ACTION
 When "CONT1"
  If [M]ETAT="TEB_PIECE" & [M]OBJET(nolign-1)="GTE"
   [M]DEBFIN(nolign-1)=4
  Endif
 When "INIPAR2"
  If [M]ETAT="TEB_PIECE" & [M]OBJET(nolign-1)="GTE"
   [M]DEBFIN(nolign-1)=1 : mkstat=1
  Endif
Endcase
Return

###########################################################################################################
Subprog IMPRIME(NBPAR,PARAMETRE)
Variable Integer NBPAR
Variable Char    PARAMETRE()(1..)

Local Integer ZDEBUG : ZDEBUG = 0          # 1 = mostra o nome antes/depois (so para testar)
Local Integer ZDBGPAR : ZDBGPAR = 0        # 1 = avisa se faltar algum parametro do .rpt (diagnostico)
Local Char    ZDOC(80), ZDOCFIN(80), ZFMT(20), ZEXT(10), ZNOME(250), ZOLD(250), ZDIR(250)
Local Char    ZVAL(250), ZREQ(30), ZFALTA(250)
Local Char    ZPARS(20)(1..21)
Local Integer ZI, ZPOS

# --- Parametros obrigatorios do TEB_PIECE.rpt -----------------------------------------------------
# Pelo botao Imprimir do GESGAS (codigos de impressao GESARX: PIECE -> TEB_PIECE) o X3 so envia os
# parametros do AREPORTV da funcao (societe, sitedeb, pcedeb, datedeb, detana, saut + pares fin).
# O "numedt" era acrescentado pelo RPTLEG ($TRTJOU: SETPARAM("numedt",...)); como ja nao chamamos o
# TRTJOU (o .rpt deixou de usar a AREPORTM), tem de ser posto aqui, senao o Crystal da
# "Valores de parametro ausentes" (ERR 504).
Call GETPARAM("numedt",NBPAR,PARAMETRE,ZVAL) From ETAT
If ZVAL = "?????"
 Call GETPARAM("__REQUETE",NBPAR,PARAMETRE,ZREQ) From ETAT
 If ZREQ = "?????" : ZREQ = "0" : Endif
 Call SETPARAM("numedt",NBPAR,PARAMETRE,ZREQ) From ETAT
Endif

# Pelo botao Imprimir tambem nao chega o "typpcefin" (o tipo de documento nao esta no AREPORTV do
# GESGAS, logo o supervisor nao gera o par deb/fin). Intervalo completo = todos os tipos, como no ecra
# de parametros (typpcedeb="" / typpcefin="zzzzzzzzzz"); o documento ja fica restrito por pcedeb/pcefin.
Call GETPARAM("typpcefin",NBPAR,PARAMETRE,ZVAL) From ETAT
If ZVAL = "?????"
 ZVAL = ""           : Call SETPARAM("typpcedeb",NBPAR,PARAMETRE,ZVAL) From ETAT
 ZVAL = "zzzzzzzzzz" : Call SETPARAM("typpcefin",NBPAR,PARAMETRE,ZVAL) From ETAT
Endif

# Diagnostico: lista os parametros do .rpt que nao chegaram (para completar acima, se preciso)
If ZDBGPAR
 ZPARS(1)="societe" : ZPARS(2)="sitedeb" : ZPARS(3)="sitefin" : ZPARS(4)="datedeb"
 ZPARS(5)="datefin" : ZPARS(6)="nbaxe" : ZPARS(7)="detana" : ZPARS(8)="saut"
 ZPARS(9)="pcedeb" : ZPARS(10)="pcefin" : ZPARS(11)="X3FCT" : ZPARS(12)="X3PRF"
 ZPARS(13)="X3USR" : ZPARS(14)="X3SIT" : ZPARS(15)="X3LAN" : ZPARS(16)="touref"
 ZPARS(17)="referentiel" : ZPARS(18)="impselections" : ZPARS(19)="numedt"
 ZPARS(20)="typpcedeb" : ZPARS(21)="typpcefin"
 ZFALTA = ""
 For ZI = 1 To 21
  Call GETPARAM(ZPARS(ZI),NBPAR,PARAMETRE,ZVAL) From ETAT
  If ZVAL = "?????" : ZFALTA += " " + ZPARS(ZI) : Endif
 Next ZI
 If ZFALTA <> "" : Infbox "ZTRTJOULEG - parametros em falta:" + ZFALTA : Endif
Endif

Call GETPARAM("pcedeb",NBPAR,PARAMETRE,ZDOC) From ETAT
Call GETPARAM("pcefin",NBPAR,PARAMETRE,ZDOCFIN) From ETAT
# So quando se imprime 1 documento (deb = fin)
If ZDOC = "" | ZDOC = "?????" | ZDOC <> ZDOCFIN : End : Endif

# Nome seguro para ficheiro: / \ : * ? < > | e espacos -> "-"
ZNOME = ctrans(ZDOC, "/\:*?<>| ", "---------")

# Extensao a partir do formato (29 = PDF; outros: manter a do _ExportFile atual, se houver)
Call GETPARAM("_FormatExport",NBPAR,PARAMETRE,ZFMT) From ETAT
ZFMT = ctrans(ZFMT, chr$(1), "")
ZEXT = ".pdf"
If ZFMT <> "29" & ZFMT <> "?????" & ZFMT <> "" : ZEXT = "" : Endif

# _ExportFile ja existente?
ZPOS = 0 : ZOLD = ""
For ZI = 1 To NBPAR
 If left$(PARAMETRE(ZI),12) = "_ExportFile="
  ZPOS = ZI
  ZOLD = ctrans(mid$(PARAMETRE(ZI),13,250), chr$(1), "")
 Endif
Next ZI

If ZPOS
 # manter pasta e extensao, trocar so o nome
 ZDIR = ""
 For ZI = len(ZOLD) To 1 Step -1
  If mid$(ZOLD,ZI,1) = "\" | mid$(ZOLD,ZI,1) = "/" : ZDIR = left$(ZOLD,ZI) : Break : Endif
 Next ZI
 For ZI = len(ZOLD) To 1 Step -1
  If mid$(ZOLD,ZI,1) = "." : ZEXT = mid$(ZOLD,ZI,10) : Break : Endif
  If mid$(ZOLD,ZI,1) = "\" | mid$(ZOLD,ZI,1) = "/" : Break : Endif
 Next ZI
 PARAMETRE(ZPOS) = "_ExportFile=" + chr$(1) + ZDIR + ZNOME + ZEXT
Else
 NBPAR += 1
 ZPOS = NBPAR
 PARAMETRE(ZPOS) = "_ExportFile=" + chr$(1) + ZNOME + ZEXT
Endif

# NOTA (testado 2026-10-07 + comunidade Sage): na PRE-VISUALIZACAO web o nome do ficheiro descarregado
# e atribuido pelo X3 (codigo do relatorio) e IGNORA o _ExportFile. O nome so e respeitado em destinos
# do tipo ficheiro/email/workflow. Mantido porque e inofensivo e serve esses destinos.

If ZDEBUG
 Infbox "ZTRTJOULEG - _ExportFile antes=[" + ZOLD + "] depois=[" + ctrans(PARAMETRE(ZPOS), chr$(1), "~") + "] (NBPAR=" + num$(NBPAR) + ")"
Endif
End
